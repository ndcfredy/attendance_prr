<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="loginRoot" styleClass="login-root" fx:controller="app.ui.LoginController">
   <VBox alignment="CENTER" maxWidth="440" maxHeight="-Infinity" spacing="14" styleClass="login-card">
      <SVGPath fx:id="logoIcon" styleClass="icon" scaleX="3" scaleY="3" content="M3 3h6v2H5v4H3V3zm12 0h6v6h-2V5h-4V3zM3 15h2v4h4v2H3v-6zm16 0h2v6h-6v-2h4v-4zM8 8h3v3H8V8zm5 0h3v3h-3V8zm-5 5h3v3H8v-3z"/>
      <Region prefHeight="16"/>
      <Label fx:id="titleLabel" styleClass="title" text="Attendance &amp; Teaching Log"/>
      <Label fx:id="subtitleLabel" styleClass="muted" text="Sign in with your staff account"/>
      <TextField fx:id="usernameField" promptText="Username" maxWidth="Infinity"/>
      <PasswordField fx:id="passwordField" promptText="Password" maxWidth="Infinity" onAction="#onLogin"/>
      <Label fx:id="loginErrorLabel" styleClass="error-label" wrapText="true"/>
      <Button fx:id="btnLogin" styleClass="btn-primary" text="Sign in" defaultButton="true" maxWidth="Infinity" onAction="#onLogin"/>
      <Separator/>
      <Label styleClass="muted" text="Entrance kiosk (students scan their own card)"/>
      <HBox spacing="8">
         <ComboBox fx:id="kioskRoomCombo" promptText="Room of this kiosk" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
         <Button fx:id="btnKiosk" styleClass="btn-outline" text="Open kiosk" onAction="#onOpenKiosk"/>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="10">
         <Label fx:id="dbStatusLabel" styleClass="muted" text="Checking database…" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
         <ToggleButton fx:id="themeToggle" styleClass="btn-outline" text="Light theme" onAction="#onToggleTheme"/>
      </HBox>
   </VBox>
</StackPane>
