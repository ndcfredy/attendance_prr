<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="logRoot" spacing="16" fx:controller="app.ui.TeachingLogController">
   <padding><Insets top="22" right="26" bottom="22" left="26"/></padding>
   <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
      <HBox alignment="CENTER_LEFT" spacing="10">
         <Label styleClass="page-title" text="Teaching log"/>
         <Region HBox.hgrow="ALWAYS"/>
         <ChoiceBox fx:id="courseFilter" prefWidth="280"/>
         <Button fx:id="btnRefresh" styleClass="btn-outline" text="Refresh" onAction="#onRefresh"/>
         <Button fx:id="btnPrintLog" styleClass="btn-primary" text="Print official log" onAction="#onPrintLog"/>
      </HBox>
      <TableView fx:id="logTable" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colLDate" text="Date" prefWidth="95"/>
            <TableColumn fx:id="colLCourse" text="Course unit" prefWidth="230"/>
            <TableColumn fx:id="colLType" text="Type" prefWidth="90"/>
            <TableColumn fx:id="colLTopics" text="Topics covered" prefWidth="260"/>
            <TableColumn fx:id="colLLecturer" text="Lecturer" prefWidth="150"/>
            <TableColumn fx:id="colLSign" text="Class rep." prefWidth="120"/>
         </columns>
         <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
      </TableView>
   </VBox>
   <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll" minWidth="400" prefWidth="400" maxWidth="400">
      <VBox spacing="8" styleClass="card">
         <Label styleClass="section-title" text="Entry details"/>
         <Label fx:id="topicsLabel" wrapText="true" text="Select an entry"/>
         <Label styleClass="muted" text="Topics – details"/>
         <TextArea fx:id="detailsArea" editable="false" prefRowCount="2" wrapText="true"/>
         <Label styleClass="muted" text="Activities"/>
         <TextArea fx:id="activitiesArea" editable="false" prefRowCount="2" wrapText="true"/>
         <Label styleClass="muted" text="Assignments"/>
         <TextArea fx:id="assignmentsArea" editable="false" prefRowCount="2" wrapText="true"/>
         <Label styleClass="muted" text="Resources"/>
         <TextArea fx:id="resourcesArea" editable="false" prefRowCount="2" wrapText="true"/>
         <Label styleClass="muted" text="Remarks"/>
         <TextArea fx:id="remarksArea" editable="false" prefRowCount="2" wrapText="true"/>
         <Label fx:id="disputeLabel" styleClass="bad-text" wrapText="true"/>
         <Button fx:id="btnResolveDispute" styleClass="btn-outline" text="Resolve dispute" onAction="#onResolveDispute"/>
      </VBox>
   </ScrollPane>
</HBox>
