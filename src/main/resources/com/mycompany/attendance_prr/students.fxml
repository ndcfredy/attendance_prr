<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:id="studentsRoot" spacing="16" fx:controller="app.ui.StudentsController">
   <padding><Insets top="22" right="26" bottom="22" left="26"/></padding>
   <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
      <HBox alignment="CENTER_LEFT" spacing="10">
         <Label styleClass="page-title" text="Students"/>
         <Region HBox.hgrow="ALWAYS"/>
         <ChoiceBox fx:id="groupFilter" prefWidth="140"/>
         <TextField fx:id="searchField" promptText="Search name or ID" prefWidth="200"/>
      </HBox>
      <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colCode" text="ID" prefWidth="110"/>
            <TableColumn fx:id="colName" text="Name" prefWidth="220"/>
            <TableColumn fx:id="colGroup" text="Group" prefWidth="90"/>
            <TableColumn fx:id="colRep" text="Class rep." prefWidth="90"/>
            <TableColumn fx:id="colCard" text="Card" prefWidth="90"/>
            <TableColumn fx:id="colPhone" text="Phone (mode B)" prefWidth="150"/>
         </columns>
         <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
      </TableView>
   </VBox>
   <VBox spacing="16" minWidth="380" prefWidth="380" maxWidth="380">
      <VBox fx:id="formPane" spacing="10" styleClass="card">
         <Label styleClass="section-title" text="Student record"/>
         <HBox spacing="12">
            <StackPane styleClass="photo-box" minWidth="96" minHeight="96" prefWidth="96" prefHeight="96" maxWidth="96" maxHeight="96">
               <SVGPath fx:id="photoPlaceholder" styleClass="icon" scaleX="2.6" scaleY="2.6" content="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z"/>
               <ImageView fx:id="photoView" fitWidth="96" fitHeight="96" preserveRatio="true"/>
            </StackPane>
            <VBox spacing="8" alignment="CENTER_LEFT">
               <Button fx:id="btnChoosePhoto" styleClass="btn-outline" text="Choose photo…" onAction="#onChoosePhoto"/>
               <Label fx:id="phoneLabel" styleClass="muted" text="Phone: –"/>
               <Button fx:id="btnResetPhone" styleClass="btn-outline" text="Reset phone" onAction="#onResetPhone"/>
            </VBox>
         </HBox>
         <TextField fx:id="codeField" promptText="Student ID (e.g. PKF2026-001)"/>
         <TextField fx:id="nameField" promptText="Full name"/>
         <ChoiceBox fx:id="groupCombo" maxWidth="Infinity"/>
         <CheckBox fx:id="repCheck" text="Class representative"/>
         <HBox spacing="8">
            <Button fx:id="btnNew" styleClass="btn-outline" text="New" onAction="#onNew"/>
            <Button fx:id="btnSave" styleClass="btn-primary" text="Save" onAction="#onSave"/>
            <Button fx:id="btnDeactivate" styleClass="btn-outline" text="Deactivate" onAction="#onDeactivate"/>
         </HBox>
         <HBox spacing="8">
            <Button fx:id="btnExportCard" styleClass="btn-outline" text="Export card (PNG)" onAction="#onExportCard"/>
            <Button fx:id="btnRevokeCard" styleClass="btn-outline" text="Revoke card" onAction="#onRevokeCard"/>
            <Button fx:id="btnCopyCard" styleClass="btn-outline" text="Copy card text" onAction="#onCopyCard"/>
         </HBox>
      </VBox>
      <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
         <Label styleClass="section-title" text="Attendance history"/>
         <Label fx:id="absenceLabel" styleClass="muted" text="Select a student"/>
         <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" prefHeight="200">
            <columns>
               <TableColumn fx:id="hColCourse" text="Course unit" prefWidth="150"/>
               <TableColumn fx:id="hColSessions" text="Sess." prefWidth="50"/>
               <TableColumn fx:id="hColPresent" text="Pres." prefWidth="50"/>
               <TableColumn fx:id="hColAbsent" text="Abs." prefWidth="50"/>
               <TableColumn fx:id="hColRate" text="Unjust. %" prefWidth="70"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
         </TableView>
      </VBox>
   </VBox>
</HBox>
